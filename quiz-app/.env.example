# --- HubSpot CRM (primaere Lead-Senke) -------------------------------------
#
# Private-App-Token. Anlegen in HubSpot unter:
#   Einstellungen -> Integrationen -> Private Apps -> "Private App erstellen"
# Benoetigte Scopes (mehr braucht es nicht):
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.schemas.contacts.read
# EU-Portale (app-eu1.hubspot.com) vergeben Tokens im Format "pat-eu1-...".
HUBSPOT_PRIVATE_APP_TOKEN=

# Nur setzen, wenn der Standard-Endpunkt nicht funktioniert. Meldet der erste
# Lead einen Hublet-/Routing-Fehler, hier auf https://api-eu1.hubapi.com
# stellen. Leer lassen = https://api.hubapi.com
HUBSPOT_API_BASE_URL=

# --- Lead Routing Portal (Zweitsenke, optional) ----------------------------
#
# Postet jeden Quiz-Lead zusaetzlich ans Lead Routing Portal
# (POST {LEADPORTAL_URL}/api/v1/leads/inbound) — inkl. aller Quiz-Antworten,
# Lead-Score, Intent, UTM-Herkunft und fbclid. Fehler dort kosten den Lead
# nicht, sie werden nur geloggt. Ohne Key ist die Weiterleitung deaktiviert.

# Der INBOUND_API_KEY der Portal-App (steht in deren Coolify-Env).
LEADPORTAL_API_KEY=

# Basis-URL des Portals. Leer lassen = https://leads.elevo.solutions
LEADPORTAL_URL=

# Optional: UUID eines Kunden-Profils im Portal. Gesetzt = Quiz-Leads werden
# direkt diesem Kunden zugewiesen und mit dessen Standard-Preis bepreist.
# Leer = Leads kommen unzugewiesen an, Routing im Admin-Bereich des Portals.
LEADPORTAL_CLIENT_ID=

# --- monday.com (Uebergangs-Fallback) --------------------------------------
#
# Wird nur noch angesprochen, wenn der HubSpot-Aufruf fehlschlaegt. Ist der
# Wechsel abgeschlossen, diese beiden Variablen entfernen — dann faellt der
# Fallback-Zweig von selbst weg.

# monday.com API-Token (Server-seitig, NIE im Frontend verwenden).
# In Coolify bei dieser App-Resource als Environment-Variable setzen.
MONDAY_API_KEY=

# Ziel-Board "Fulfillmentbuddy Leads" in monday CRM. Default passt bereits,
# nur ändern falls ein anderes Board verwendet werden soll.
MONDAY_BOARD_ID=5103645238

# Twilio Verify (SMS-OTP für die Telefonnummer-Verifizierung im Quiz).
# Console: twilio.com/console (Account SID + Auth Token) und
# Verify > Services (Service SID, "VAxxxxx...").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
